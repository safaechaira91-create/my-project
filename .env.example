# MyDar Environment Template
# Copy this file to `.env` for local development.

# App Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Database (MongoDB)
MONGODB_URI=your_mongodb_connection_string_here

# Auth Secrets (JWT)
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_secret

# PayPal Services
PAYPAL_CLIENT_ID=your_paypal_server_client_id
PAYPAL_CLIENT_SECRET=your_paypal_server_client_secret

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Admin (Storage)
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_KEY_PATH=./serviceAccountKey.json

# Email / SMTP Settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="MyDar <no-reply@mydar.local>"

# Frontend Configurations (Vite)
VITE_API_URL=/api
VITE_PAYPAL_CLIENT_ID=your_paypal_browser_client_id